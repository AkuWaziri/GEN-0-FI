# Server-side Gemini API key. Never expose this in VITE_* variables.
GEMINI_API_KEY=""

# Arc Mainnet RPC. The application uses this for authoritative live balances/receipts.
ARC_MAINNET_RPC_URL="https://rpc.mainnet.arc.io"

# Optional Blockscout Pro API key for higher rate limits. The public Arc explorer API is used when omitted.
BLOCKSCOUT_API_KEY=""

# Optional application URL.
APP_URL=""

# Reown / WalletConnect Cloud Project ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""


# GEN-0FI LI.FI monetization
# Register GEN-0FI in the LI.FI Partner Portal and configure this same treasury wallet there.
GEN0FI_LIFI_INTEGRATOR="GEN-0FI"
# Decimal fee: 0.003 = 0.30%
GEN0FI_LIFI_FEE="0.003"
# Public treasury/fee wallet address. Never put a private key here.
GEN0FI_FEE_WALLET="0xYourTreasuryWalletAddress"
# Optional LI.FI API key if your integration is issued one.
LIFI_API_KEY=""
